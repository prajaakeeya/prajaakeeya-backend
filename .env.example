# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/prajaakeya
# Set to true ONLY for local dev to auto-create tables from entities.
# NEVER use in production — run migrations instead.
TYPEORM_SYNCHRONIZE=true
DB_POOL_MAX=10
# Production TLS — set one of these when NODE_ENV != development:
# RDS_SSL_INSECURE=true
# RDS_CA_PATH=/opt/rds/global-bundle.pem

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=120d

# ── Google OAuth 2.0 (voter/aspirant login) ──────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/success

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS_DEV=http://localhost:5173,https://staging.prajaakeeya.org
CORS_ALLOWED_ORIGINS_PROD=https://prajaakeeya.org,https://www.prajaakeeya.org

# ── AWS S3 / CloudFront ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=prajaakeeya
AWS_REGION=ap-south-1
# Optional CDN — if set, media URLs use this domain instead of S3 directly
# AWS_CLOUDFRONT_DOMAIN=d1234abcd.cloudfront.net

# ── Redis (optional — falls back to in-memory if omitted) ───────────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ── Caching & rate limiting ──────────────────────────────────────────────────
# CACHE_TTL_MS=60000
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=200
# VOTE_THROTTLE_LIMIT=5

# ── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Use either the JSON string or a path to the file on disk.
# If neither is set, push notifications are disabled (in-app still works).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-adminsdk.json

# ── Sentry error tracking ────────────────────────────────────────────────────
# Leave unset to disable. Set SENTRY_TRACES_SAMPLE_RATE=0 for errors only.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.1
